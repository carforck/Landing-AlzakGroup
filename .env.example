# ── Formulario de contacto (Resend) ────────────────────────────────
# Mismo proveedor de correo que usa el landing de ALZAK Foundation.
# Sin RESEND_API_KEY el endpoint /api/contact responde 503 y el formulario
# invita a escribir directamente a info@alzak.com.co.
RESEND_API_KEY=

# Remitente. El dominio debe estar verificado en Resend.
CONTACT_FROM_EMAIL="ALZAK Consulting & Research <no-reply@alzak.com.co>"

# Destinatario. Si se omite, se usa contact.email de src/content/site.ts
CONTACT_TO_EMAIL=info@alzak.com.co

# ── Vista de administración (/admin) ───────────────────────────────
# Lectura de las bases de CAPULMON para el seguimiento por centro.
# Las credenciales están en dash-seguimiento-capulmon/credenciales.json.
# Sin estas variables /admin no consulta nada y explica qué falta.
CAPULMON_DB_HOST=
CAPULMON_DB_PORT=3306
CAPULMON_DB_USER=
CAPULMON_DB_PASSWORD=
CAPULMON_DB_NAME=AnaliticaDB

# Clave de /admin (proxy.ts). HTTP Basic; si falta alguna, /admin responde 503
# en lugar de abrirse, porque el panel muestra datos de salud (Ley 1581).
ADMIN_USER=
ADMIN_PASSWORD=

# Firma de la cookie de sesión del portal /portal (mínimo 32 caracteres).
# Rotarla cierra todas las sesiones abiertas.
SESSION_SECRET=

# Sólo en `next dev`: 1 permite entrar a /portal/<empresa> por la ruta, sin login.
# En producción no tiene efecto.
PORTAL_SIN_LOGIN=

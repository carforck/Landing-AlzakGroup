# ── Formulario de contacto (Resend) ────────────────────────────────
# Mismo proveedor de correo que usa el landing de ALZAK Foundation.
# Sin RESEND_API_KEY el endpoint /api/contact responde 503 y el formulario
# invita a escribir directamente a info@alzak.com.co.
RESEND_API_KEY=

# Remitente. El dominio debe estar verificado en Resend.
CONTACT_FROM_EMAIL="ALZAK Consulting & Research <no-reply@alzak.com.co>"

# Destinatario. Si se omite, se usa contact.email de src/content/site.ts
CONTACT_TO_EMAIL=info@alzak.com.co
